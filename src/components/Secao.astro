---
const { id, titulo, intro } = Astro.props;
---
<section id={id} class="border-t border-areia py-12 first:border-t-0 lg:py-16">
  <h2 class="text-2xl font-bold tracking-tight lg:text-3xl">{titulo}</h2>
  {intro && <p class="mt-2 max-w-2xl text-sm text-ameixa/75">{intro}</p>}
  <div class="mt-8"><slot /></div>
</section>
