---
import Base from '../layouts/Base.astro';
import { clientes } from '../data/clientes.js';

const dataBR = (d) => d.split('-').reverse().join('/');
---
<Base titulo="Brand Hub Delipe">
  <header class="bg-noite text-white">
    <div class="mx-auto max-w-6xl px-4 pt-6 pb-14 sm:px-8">
      <img src="/delipe-logo.png" alt="Delipe" class="h-7 w-auto" />
      <h1 class="mt-12 text-3xl font-bold tracking-tight sm:text-5xl">Brand Hub</h1>
      <p class="mt-3 max-w-xl text-sm text-areia sm:text-base">O padrão de marca de cada cliente, em um só lugar. Escolha o cliente e comece o projeto.</p>
      <label class="mt-8 block max-w-md">
        <span class="sr-only">Buscar cliente</span>
        <input id="busca" type="search" placeholder="Buscar cliente" autocomplete="off"
          class="w-full rounded-xl border border-white/15 bg-white/10 px-4 py-3 text-base text-white placeholder:text-areia/60 focus:border-laranja focus:outline-none" />
      </label>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-8">
    <ul id="lista" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {clientes.map((c) => (
        <li data-nome={c.nome.toLowerCase()}>
          <a href={`/${c.slug}/`} class="group block overflow-hidden rounded-2xl border border-areia bg-white transition hover:-translate-y-0.5 hover:border-laranja">
            <div class="flex h-40 items-center justify-center p-8" style={`background:${c.fundo}`}>
              <img src={c.capa.logo} alt={`Logo ${c.nome}`} class="max-h-20 max-w-[70%]" />
            </div>
            <div class="flex items-center justify-between gap-3 p-4">
              <div>
                <p class="font-semibold">{c.nome}</p>
                <p class="mt-0.5 text-xs text-ameixa/70">Atualizado em {dataBR(c.atualizado)}</p>
              </div>
              {c.status !== 'aprovado' && <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800 capitalize">{c.status}</span>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p id="vazio" hidden class="py-10 text-center text-sm text-ameixa/70">Nenhum cliente encontrado.</p>
  </main>

  <script>
    const busca = document.getElementById('busca');
    const itens = [...document.querySelectorAll('#lista li')];
    const vazio = document.getElementById('vazio');
    busca.addEventListener('input', () => {
      const q = busca.value.trim().toLowerCase();
      let achou = 0;
      for (const li of itens) {
        const ok = li.dataset.nome.includes(q);
        li.hidden = !ok;
        achou += ok ? 1 : 0;
      }
      vazio.hidden = achou > 0;
    });
  </script>
</Base>
