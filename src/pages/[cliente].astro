---
import Base from '../layouts/Base.astro';
import Secao from '../components/Secao.astro';
import { clientes } from '../data/clientes.js';

export function getStaticPaths() {
  return clientes.map((c) => ({ params: { cliente: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const fonte = c.familiaPrincipal;
const fontePrincipal = c.familias.find((f) => f.nome === fonte);
const temCliente = Boolean(c.gosta || c.naoGosta || c.licoes.length);
const prosa = 'prose prose-sm max-w-3xl prose-headings:font-semibold prose-strong:text-noite prose-a:text-laranja prose-code:rounded prose-code:bg-areia/50 prose-code:px-1 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none text-ameixa';
const menu = [
  ['comece', 'Comece aqui'],
  ['logo', 'Logo'],
  ['cores', 'Cores'],
  ['tipografia', 'Tipografia'],
  ['elementos', 'Elementos'],
  ['imagem', 'Imagem'],
  ['layouts', 'Layouts'],
  ['voz', 'Voz e copy'],
  ['ofertas', 'Ofertas e ADS'],
  ...(temCliente ? [['cliente', 'O que o cliente gosta']] : []),
  ['arquivos', 'Arquivos'],
];
const dataBR = (d) => d.split('-').reverse().join('/');
const proporcao = c.cores.filter((x) => x.pct > 0);
---
<Base titulo={`${c.nome} · Brand Hub Delipe`} fontes={c.fontesGoogle}>
  <div class="lg:flex">
    <aside class="sticky top-0 z-20 bg-noite text-white lg:h-screen lg:w-64 lg:shrink-0 lg:overflow-y-auto">
      <div class="flex items-center justify-between gap-3 px-4 py-3 lg:block lg:px-6 lg:pt-7">
        <a href="/" aria-label="Voltar para a lista de clientes"><img src="/delipe-logo.png" alt="Delipe" class="h-6 w-auto" /></a>
        <a href="/" class="text-xs text-areia hover:text-white lg:mt-6 lg:block">← Todos os clientes</a>
      </div>
      <nav aria-label="Seções do guia" class="flex gap-1 overflow-x-auto px-3 pb-3 [scrollbar-width:none] lg:mt-4 lg:flex-col lg:overflow-visible lg:px-3">
        {menu.map(([id, rotulo]) => (
          <a href={`#${id}`} data-menu={id} class="rounded-lg px-3 py-2 text-[13px] whitespace-nowrap text-areia transition hover:bg-white/10 hover:text-white data-[ativo]:bg-laranja data-[ativo]:font-semibold data-[ativo]:text-white">{rotulo}</a>
        ))}
      </nav>
    </aside>

    <main class="min-w-0 flex-1">
      <header class="px-4 py-10 sm:px-10 lg:py-14" style={`background:${c.fundo}`}>
        <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-6">
          <img src={c.capa.logo} alt={`Logo ${c.nome}`} class="h-16 w-auto sm:h-20" />
          {c.capa.slogan && <img src={c.capa.slogan} alt="" class="h-11 w-auto sm:h-14" />}
        </div>
      </header>

      <div class="mx-auto max-w-5xl px-4 sm:px-10">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-6">
          <h1 class="text-xl font-bold">{c.nome}</h1>
          {c.status !== 'aprovado' && <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800 capitalize">{c.status}</span>}
          <span class="text-xs text-ameixa/70">Atualizado em {dataBR(c.atualizado)}</span>
        </div>

        <Secao id="comece" titulo="Comece aqui">
          <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr]">
            <div class={prosa} set:html={c.html.essencia} />
            <div>
              {proporcao.length > 0 && (
                <div class="mb-5">
                  <div class="flex h-20 overflow-hidden rounded-xl">
                    {proporcao.map((x) => <span style={`background:${x.hex};flex:${x.pct}`} title={`${x.nome} ${x.proporcao}`}></span>)}
                  </div>
                  <p class="mt-2 text-xs text-ameixa/70">Proporção das cores nas peças</p>
                </div>
              )}
              {fontePrincipal.link
                ? <p class="text-3xl font-extrabold tracking-tight" style={`font-family:'${fonte}',sans-serif`}>{fonte}</p>
                : fontePrincipal.disponivel
                  ? <img src={fontePrincipal.nomeImg} alt={fonte} class="h-11 w-auto max-w-full object-contain object-left" />
                  : <p class="text-lg font-semibold">{fonte}</p>}
              <p class="text-xs text-ameixa/70">Fonte principal da marca</p>
            </div>
          </div>
          {c.html.regras && (
            <div class="mt-8 rounded-2xl border border-laranja/40 bg-orange-50 p-5">
              <h3 class="text-sm font-bold text-orange-950">Regras que valem para tudo</h3>
              <div class:list={[prosa, 'mt-2']} set:html={c.html.regras} />
            </div>
          )}
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-emerald-50 p-5">
              <h3 class="text-sm font-bold text-emerald-900">Faça</h3>
              <ul class="mt-3 space-y-2 text-sm text-emerald-950">{c.faca.map((t) => <li class="flex gap-2"><span aria-hidden="true">✓</span><span>{t}</span></li>)}</ul>
            </div>
            <div class="rounded-2xl bg-rose-50 p-5">
              <h3 class="text-sm font-bold text-rose-900">Evite</h3>
              <ul class="mt-3 space-y-2 text-sm text-rose-950">{c.evite.map((t) => <li class="flex gap-2"><span aria-hidden="true">✕</span><span>{t}</span></li>)}</ul>
            </div>
          </div>
        </Secao>

        <Secao id="logo" titulo="Logo" intro="Clique em baixar para pegar o SVG oficial. Nunca redesenhe.">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {c.logos.map((l) => (
              <figure class="overflow-hidden rounded-2xl border border-areia bg-white">
                <div class="flex h-36 items-center justify-center p-6" style={`background:${l.fundo}`}>
                  <img src={l.src} alt={l.titulo} loading="lazy" class="max-h-20 max-w-[80%]" />
                </div>
                <figcaption class="p-4">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-semibold">{l.titulo}</p>
                    <a href={l.src} download class="text-xs font-semibold text-laranja hover:underline">Baixar SVG</a>
                  </div>
                  <p class="mt-1 text-xs text-ameixa/75">{l.quando}</p>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class:list={[prosa, 'mt-8']} set:html={c.html.logo} />
        </Secao>

        <Secao id="cores" titulo="Cores" intro="Clique em uma cor para copiar o HEX.">
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {c.cores.map((x) => (
              <button type="button" data-copiar={x.hex} class="overflow-hidden rounded-2xl border border-areia bg-white text-left transition hover:border-laranja">
                <span class="block h-24" style={`background:${x.hex}`}></span>
                <span class="block p-3">
                  <span class="block text-sm font-semibold">{x.nome}</span>
                  <span class="mt-0.5 block text-xs font-medium">{x.hex}</span>
                  <span class="block text-[11px] text-ameixa/70">RGB {x.rgb}</span>
                  {x.cmyk && <span class="block text-[11px] text-ameixa/70">CMYK {x.cmyk}</span>}
                  {x.pantone && <span class="block text-[11px] text-ameixa/70">Pantone {x.pantone}</span>}
                  <span class="mt-1.5 block text-xs text-ameixa/80">{x.papel}{x.proporcao && ` · ${x.proporcao}`}</span>
                </span>
              </button>
            ))}
          </div>

          <h3 class="mt-10 text-base font-bold">Degradês</h3>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {c.gradientes.map((g) => (
              <figure>
                <div class="h-20 rounded-xl" style={`background:${g.css}`}></div>
                <figcaption class="mt-2 text-sm font-semibold">{g.nome}<span class="block text-xs font-normal text-ameixa/70">{g.direcao}</span></figcaption>
              </figure>
            ))}
          </div>

          <div class="mt-10 grid gap-8 lg:grid-cols-2">
            <div>
              <h3 class="text-base font-bold">Combinações aprovadas</h3>
              <ul class="mt-4 space-y-2">
                {c.contraste.ok.map((x) => (
                  <li class="flex items-center gap-3 text-sm">
                    {x.bg && x.fg
                      ? <span class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-areia text-base font-bold" style={`background:${x.bg};color:${x.fg}`}>Aa</span>
                      : <span class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-areia text-emerald-700" aria-hidden="true">✓</span>}
                    <span>{x.texto}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-base font-bold">Combinações proibidas</h3>
              <ul class="mt-4 space-y-2">
                {c.contraste.nao.map((x) => (
                  <li class="flex items-center gap-3 text-sm">
                    {x.bg && x.fg
                      ? <span class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-areia text-base font-bold" style={`background:${x.bg};color:${x.fg}`}>Aa</span>
                      : <span class="flex size-11 shrink-0 items-center justify-center rounded-lg border border-areia text-rose-700" aria-hidden="true">✕</span>}
                    <span>{x.texto}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class:list={[prosa, 'mt-8']} set:html={c.html.cores} />
        </Secao>

        <Secao id="tipografia" titulo="Tipografia">
          <div class="grid gap-4 sm:grid-cols-2">
            {c.familias.map((f) => (
              <div class:list={['rounded-2xl border border-areia bg-white p-5', { 'sm:col-span-2': f.especime }]}>
                {f.link && <p class="text-3xl font-bold" style={`font-family:'${f.nome}',sans-serif`}>{f.nome}</p>}
                {f.nomeImg && <img src={f.nomeImg} alt={f.nome} class="h-11 w-auto max-w-full object-contain object-left" />}
                {!f.link && !f.nomeImg && <p class="text-lg font-semibold">{f.nome}</p>}
                <p class="mt-2 text-sm text-ameixa">{f.uso}</p>
                <p class="mt-1 text-xs text-ameixa/70">Pesos: {f.pesos}</p>
                {f.especime && <img src={f.especime} alt={`Amostra da fonte ${f.nome} nos pesos da marca`} loading="lazy" class="mt-4 w-full max-w-2xl" />}
                {f.link
                  ? <a href={f.link} target="_blank" rel="noopener" class="mt-3 inline-block text-xs font-semibold text-laranja hover:underline">Baixar no Google Fonts</a>
                  : <p class="mt-3 text-xs text-ameixa/70">{f.disponivel ? 'Amostra em imagem: esta fonte não fica no site.' : 'Sem amostra: esta fonte não está disponível para gerar a imagem.'} <span class="font-semibold">Onde encontrar:</span> {f.onde}</p>}
              </div>
            ))}
          </div>

          <h3 class="mt-10 text-base font-bold">Escala para arte de 1080 px</h3>
          <div class="mt-4 overflow-x-auto rounded-2xl border border-areia bg-white">
            <table class="w-full min-w-[520px] text-left text-sm">
              <thead class="border-b border-areia text-xs text-ameixa/70">
                <tr><th class="p-3 font-medium">Papel</th><th class="p-3 font-medium">Exemplo</th><th class="p-3 font-medium">Peso</th><th class="p-3 font-medium">Tamanho</th><th class="p-3 font-medium">Entrelinha</th></tr>
              </thead>
              <tbody>
                {c.estilos.map((e) => (
                  <tr class="border-b border-areia/60 last:border-0">
                    <td class="p-3 font-medium whitespace-nowrap">{e.papel}</td>
                    {c.fontesGoogle.some((f) => f.nome === e.familia)
                      ? <td class="p-3 whitespace-nowrap" style={`font-family:'${e.familia}',sans-serif;font-weight:${e.wght};font-style:${e.italico ? 'italic' : 'normal'};font-size:${Math.max(12, Math.min(40, e.px / 2.4))}px;line-height:1.1`}>Aa 123</td>
                      : <td class="p-3 whitespace-nowrap">{e.img ? <img src={e.img} alt={`Aa 123 em ${e.familia} ${e.peso}`} style={`height:${e.imgAltura}px;width:auto;max-width:none`} /> : <span class="text-xs text-ameixa/70">Sem amostra</span>}</td>}
                    <td class="p-3">{e.peso}</td>
                    <td class="p-3">{e.px} px</td>
                    <td class="p-3">{String(e.entrelinha).replace('.', ',')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class:list={[prosa, 'mt-8']} set:html={c.html.tipografia} />
        </Secao>

        <Secao id="elementos" titulo="Elementos da marca" intro="Peças que identificam a marca à primeira vista.">
          <div class="grid items-start gap-4 lg:grid-cols-[2fr_1fr]">
            {c.elementos.map((i) => (
              <figure>
                <img src={i.src} alt={i.legenda} loading="lazy" class="w-full rounded-2xl border border-areia" />
                <figcaption class="mt-2 text-xs text-ameixa/75">{i.legenda}</figcaption>
              </figure>
            ))}
          </div>
          <div class:list={[prosa, 'mt-8']} set:html={c.html.elementos} />
        </Secao>

        <Secao id="imagem" titulo="Imagem e fotografia">
          <div class={prosa} set:html={c.html.imagem} />
        </Secao>

        <Secao id="layouts" titulo="Layouts" intro="Exemplos de cada estrutura. Use a linguagem, não os preços: as ofertas dessas peças podem estar antigas.">
          <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            {c.layouts.map((l) => (
              <figure class="overflow-hidden rounded-2xl border border-areia bg-white">
                {l.src && <img src={l.src} alt={`Exemplo do layout ${l.codigo}`} loading="lazy" class="w-full" />}
                <figcaption class="p-3">
                  <p class="text-sm font-bold">{l.codigo}</p>
                  <p class="mt-1 text-xs text-ameixa">{l.estrutura}</p>
                  <p class="mt-1 text-xs text-ameixa/70">{l.quando}</p>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class:list={[prosa, 'mt-8']} set:html={c.html.layouts} />
        </Secao>

        <Secao id="voz" titulo="Voz e copy">
          <div class={prosa} set:html={c.html.voz} />
          <h3 class="mt-10 text-base font-bold">Com quem a marca fala</h3>
          <div class:list={[prosa, 'mt-3']} set:html={c.html.publico} />
        </Secao>

        <Secao id="ofertas" titulo="Ofertas e ADS">
          <p class="mb-6 rounded-xl bg-orange-50 p-4 text-sm text-orange-950"><strong>Preços e planos mudam.</strong> Os blocos abaixo são modelos: antes de usar um valor, confira sempre na Central de Clientes ou no briefing do account.</p>
          <div class={prosa} set:html={c.html.ofertas} />
          {c.planos.length > 0 && (
            <div class:list={['mt-8 grid gap-4', { 'lg:grid-cols-2': c.planos.length > 1 }]}>
              {c.planos.map((i) => (
                <figure>
                  <img src={i.src} alt={i.legenda} loading="lazy" class="w-full rounded-2xl border border-areia" />
                  <figcaption class="mt-2 text-xs text-ameixa/75">{i.legenda}</figcaption>
                </figure>
              ))}
            </div>
          )}
          <h3 class="mt-10 text-base font-bold">Serviços e marcas parceiras</h3>
          <div class:list={[prosa, 'mt-3']} set:html={c.html.svas} />
        </Secao>

        {temCliente && <Secao id="cliente" titulo="O que o cliente gosta">
          <div class="grid gap-4 sm:grid-cols-2">
            {c.gosta && <div class="rounded-2xl border border-areia bg-white p-5"><h3 class="text-sm font-bold">Gosta de</h3><p class="mt-2 text-sm text-ameixa">{c.gosta}</p></div>}
            {c.naoGosta && <div class="rounded-2xl border border-areia bg-white p-5"><h3 class="text-sm font-bold">Não gosta de</h3><p class="mt-2 text-sm text-ameixa">{c.naoGosta}</p></div>}
          </div>
          {c.licoes.length > 0 && (
            <>
              <h3 class="mt-8 text-base font-bold">Atenção na produção</h3>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-ameixa">{c.licoes.map((l) => <li set:html={l} />)}</ul>
            </>
          )}
        </Secao>}

        <Secao id="arquivos" titulo="Arquivos" intro="Tudo o que você precisa para abrir e começar.">
          <ul class="grid gap-3 sm:grid-cols-2">
            {c.arquivos.map((a) => (
              <li>
                <a href={a.href} download class="flex items-center justify-between gap-4 rounded-2xl border border-areia bg-white p-4 transition hover:border-laranja">
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold">{a.titulo}</span>
                    <span class="block text-xs text-ameixa/75">{a.descricao}</span>
                  </span>
                  <span class="shrink-0 text-right text-xs text-ameixa/70"><span class="block font-semibold text-laranja uppercase">{a.ext}</span>{a.tamanho}</span>
                </a>
              </li>
            ))}
          </ul>
        </Secao>
      </div>
    </main>
  </div>

  <div id="aviso" role="status" aria-live="polite" class="fixed bottom-5 left-1/2 z-30 -translate-x-1/2 rounded-full bg-noite px-4 py-2 text-sm text-white opacity-0 transition-opacity"></div>

  <script>
    const aviso = document.getElementById('aviso');
    let tempo;
    document.querySelectorAll('[data-copiar]').forEach((b) => b.addEventListener('click', async () => {
      const valor = b.dataset.copiar;
      try {
        await navigator.clipboard.writeText(valor);
        aviso.textContent = `${valor} copiado`;
      } catch {
        aviso.textContent = valor;
      }
      aviso.classList.replace('opacity-0', 'opacity-100');
      clearTimeout(tempo);
      tempo = setTimeout(() => aviso.classList.replace('opacity-100', 'opacity-0'), 1600);
    }));

    const links = Object.fromEntries([...document.querySelectorAll('[data-menu]')].map((a) => [a.dataset.menu, a]));
    const obs = new IntersectionObserver((itens) => {
      for (const i of itens) {
        if (!i.isIntersecting) continue;
        Object.values(links).forEach((a) => a.removeAttribute('data-ativo'));
        const a = links[i.target.id];
        a?.setAttribute('data-ativo', '');
        a?.scrollIntoView({ block: 'nearest', inline: 'center' });
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('section[id]').forEach((s) => obs.observe(s));
  </script>
</Base>
