---
import '@fontsource-variable/sora';
import '../styles/global.css';

const { titulo, fontes = [] } = Astro.props;
const urlFonte = fontes.length
  ? `https://fonts.googleapis.com/css2?${fontes.map((f) => `family=${encodeURIComponent(f.nome)}:wght@${f.pesos.join(';')}`).join('&')}&display=swap`
  : null;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo}</title>
    {urlFonte && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {urlFonte && <link rel="stylesheet" href={urlFonte} />}
  </head>
  <body class="bg-papel font-sans text-noite antialiased">
    <slot />
  </body>
</html>
